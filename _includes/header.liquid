<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      <!-- Determine which navbar brand/logo configuration to display -->
      {% if site.icon.navbar.show_home == false %}
        <!-- Only show brand when NOT on home page -->
        {% if page.permalink != '/' %}
          <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
            <!-- Check if group logo should be displayed -->
            {% if site.icon.navbar.group_logo %}
              <!-- Display group logo image -->
              <img
                src="{{ site.url }}{{ site.baseurl }}/assets/img/logopic/{{ site.icon.navbar.group_logo }}"
                style="height: auto; max-height: 1.8rem; width: auto;"
                alt="Logo"
              >
              <!-- Optionally include site title alongside logo -->
              {% if site.icon.navbar.include_title %}
                <span class="font-weight-bold">
                  {{ site.title }}
                </span>
              {% endif %}
              @
              <!-- Display affiliation logo or short name with flag -->
              {% if site.icon.navbar.affiliation_logo %}
                <img
                  src="{{ site.url }}{{ site.baseurl }}/assets/img/logopic/{{ site.icon.navbar.affiliation_logo }}"
                  style="height: auto; max-height: 1.8rem; width: auto;"
                  alt="Logo"
                >
              {% else %}
                {{ site.affiliation_short }}
                <span class="fi fi-{{ site.country }}"></span>
              {% endif %}
            {% else %}
              <!-- Display text-only brand without group logo -->
              <span class="font-weight-bold">
                {{ site.title }}
              </span>
              @
              {% if site.icon.navbar.affiliation_logo %}
                <img
                  src="{{ site.url }}{{ site.baseurl }}/assets/img/logopic/{{ site.icon.navbar.affiliation_logo }}"
                  style="height: auto; max-height: 1.8rem; width: auto;"
                  alt="Logo"
                >
              {% else %}
                {{ site.affiliation_short }}
                <span class="fi fi-{{ site.country }}"></span>
              {% endif %}
            {% endif %}
          </a>
        {% elsif site.enable_navbar_social %}
          <!-- Social Icons -->
          <!-- On home page, show social icons instead of brand -->
          <div class="navbar-brand social">{% include social.liquid %}</div>
        {% endif %}
      {% else %}
        <!-- Always show brand (show_home is true) -->
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          {% if site.icon.navbar.group_logo %}
            <!-- Display group logo with optional title -->
            <img
              src="{{ site.url }}{{ site.baseurl }}/assets/img/logopic/{{ site.icon.navbar.group_logo }}"
              style="height: auto; max-height: 1.8rem; width: auto;"
              alt="Logo"
            >
            {% if site.icon.navbar.include_title %}
              <span class="font-weight-bold">
                {{ site.title }}
              </span>
            {% endif %}
            @
            <!-- Display affiliation (logo or text with flag) -->
            {% if site.icon.navbar.affiliation_logo %}
              <img
                src="{{ site.url }}{{ site.baseurl }}/assets/img/logopic/{{ site.icon.navbar.affiliation_logo }}"
                style="height: auto; max-height: 1.8rem; width: auto;"
                alt="Logo"
              >
            {% else %}
              {{ site.affiliation_short }}
              <span class="fi fi-{{ site.country }}"></span>
            {% endif %}
          {% else %}
            <!-- Display text-only brand -->
            <span class="font-weight-bold">
              {{ site.title }}
            </span>
            @
            {% if site.icon.navbar.affiliation_logo %}
              <img
                src="{{ site.url }}{{ site.baseurl }}/assets/img/logopic/{{ site.icon.navbar.affiliation_logo }}"
                style="height: auto; max-height: 1.8rem; width: auto;"
                alt="Logo"
              >
            {% else %}
              {{ site.affiliation_short }}
              <span class="fi fi-{{ site.country }}"></span>
            {% endif %}
          {% endif %}
          {% if site.enable_navbar_social %}
            <!-- Social Icons -->
            <!-- Include social icons alongside brand -->
            <div class="navbar-brand social">{% include social.liquid %}</div>
          {% endif %}
        </a>
      {% endif %}

      <!-- Navbar Toggle Button (hamburger menu for mobile) -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>
      <!-- Collapsible navbar menu -->
      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}
          <!-- Home/About link (conditional) -->
          {% if site.home_page_in_navbar %}
            <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
              <a class="nav-link" href="{{ site.baseurl }}/">
                {{- site.data[site.active_lang].strings.home }}
                {% if page.permalink == '/' %}
                  <span class="sr-only">(current)</span>
                {% endif %}
              </a>
            </li>
          {% endif %}
          <!-- Other pages -->
          <!-- Loop through all site pages and build navigation menu -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            <!-- Only include pages marked for navigation that aren't auto-generated -->
            {% if p.nav_header and p.autogen == null %}
              {% if p.dropdown %}
                <!-- Dropdown menu item -->
                <!-- Check if any child page is currently active -->
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <!-- Dropdown menu contents -->
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      <!-- Support dividers in dropdown menu -->
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a class="dropdown-item {% if page.title == child.title %}active{% endif %}" href="{{ child.permalink | relative_url }}">
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                <!-- Regular navigation link (not dropdown) -->
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  <!-- Special handling for blog pages -->
                  {% if p.permalink contains '/blog/' %}{% assign url = '/blog/' %} {% else %}{% assign url = p.url %}{% endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}

          <!-- Language toggle (if multilingual site) -->
          {% if site.languages.size >= 2 %}
            {% if site.languages.size == 3 %}
              <!-- Handle exactly 3 languages: show single toggle to alternate language -->
              {% if site.active_lang == site.languages.first %}
                {% assign other_language = site.languages.last %}
              {% else %}
                {% assign other_language = site.languages.first %}
              {% endif %}
              <li class="nav-item active">
                {% if site.active_lang == site.default_lang %}
                  <a class="nav-link" {% static_href -%} href="{{ site.baseurl }}/{{ other_language }}{{ page.url }}" {%- endstatic_href %}>
                    {% if site.country_flag %}
                      <span class="fi fi-{{ other_language | split: "-" | last }}"></span>
                    {% else %}
                      {{ other_language | upcase }}
                    {%- endif -%}
                  </a>
                {% else %}
                  <a class="nav-link" {% static_href -%} href="{{ site.baseurl }}{{ page.url }}" {%- endstatic_href %}>
                    {% if site.country_flag %}
                      <span class="fi fi-{{ site.default_lang | split: "-" | last }}"></span>
                    {% else %}
                      {{ site.default_lang | upcase }}
                    {%- endif -%}
                  </a>
                {% endif %}
              </li>
            {% else %}
              <!-- Handle 2 or 4+ languages: show dropdown menu -->
              <li class="nav-item dropdown {% if page.title == p.title %}active{% endif %}">
                <a
                  class="nav-link dropdown-toggle"
                  href="#"
                  id="navbarDropdown"
                  role="button"
                  data-toggle="dropdown"
                  aria-haspopup="true"
                  aria-expanded="false"
                >
                  <!-- Display current language with optional flag -->
                  {% if site.country_flag %}
                    {{- site.active_lang | split: '-' | first | upcase }}
                    <span class="fi fi-{{ site.active_lang | split: "-" | last }}"></span>
                  {% else %}
                    {{- site.active_lang | upcase }}
                  {%- endif -%}
                  {% if page.title == p.title %}
                    <span class="sr-only">(current)</span>
                  {% endif %}
                </a>
                <!-- Dropdown with all available languages -->
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                  {% assign language_set = false %}
                  {% for l in site.languages %}
                    <!-- Skip current active language -->
                    {% if l != site.active_lang %}
                      <!-- Add divider between language options -->
                      {% if language_set %}
                        <div class="dropdown-divider"></div>
                      {% endif %}
                      <!-- Handle default language (no prefix in URL) -->
                      {% if l == site.default_lang %}
                        <a class="dropdown-item" {% static_href -%} href="{{ site.baseurl }}{{ page.url }}" {%- endstatic_href %}>
                          {% if site.country_flag %}
                            {{- l | split: '-' | first | upcase }}
                            <span class="fi fi-{{ l | split: "-" | last }}"></span>
                          {% else %}
                            {{ l | upcase }}
                          {%- endif -%}
                        </a>
                      {% else %}
                        <!-- Non-default language (add language prefix to URL) -->
                        <a class="dropdown-item" {% static_href -%} href="{{ site.baseurl }}/{{ l }}{{ page.url }}" {%- endstatic_href %}>
                          {% if site.country_flag %}
                            {{- l | split: '-' | first | upcase }}
                            <span class="fi fi-{{ l | split: "-" | last }}"></span>
                          {% else %}
                            {{ l | upcase }}
                          {%- endif -%}
                        </a>
                      {% endif %}
                      {% assign language_set = true %}
                    {% endif %}
                  {% endfor %}
                </div>
              </li>
            {% endif %}
          {% endif %}

          <!-- Theme mode toggle (light/dark mode) -->
          {% if site.enable_darkmode %}
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="ti ti-sun-moon" id="light-toggle-system"></i>
                <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
                <i class="ti ti-sun-filled" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}

          <!-- Search button -->
          {% if site.search_enabled %}
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link"> <i class="ti ti-search"></i></span>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>

  <!-- Scrolling Progress Bar (shows reading progress on page) -->
  {% if site.enable_progressbar %}
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
