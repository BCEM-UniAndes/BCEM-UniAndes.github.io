{% assign m = include.member %}

{% if m.orcidusername %}
  - <a target="_blank" href="https://orcid.org/{{ m.orcidusername }}"><i class="ai ai-orcid"></i></a>
{%- endif %}
{% if m.scholarusername %}
  - <a target="_blank" href="https://scholar.google.com/citations?user={{ m.scholarusername }}"><i class="ai ai-google-scholar"></i></a>
{%- endif %}
{% if m.resgateusername %}
  - <a target="_blank" href="https://www.researchgate.net/profile/{{ m.resgateusername }}"><i class="ai ai-researchgate"></i></a>
{%- endif %}
{% if m.linkedinusername %}
  - <a target="_blank" href="https://www.linkedin.com/in/{{ m.linkedinusername }}"><i class="fa-brands fa-linkedin"></i></a>
{%- endif %}
{% if m.githubusername %}
  - <a target="_blank" href="https://github.com/{{ m.githubusername }}"><i class="fa-brands fa-github"></i></a>
{%- endif %}
{% if m.blueskyusername %}
  - <a target="_blank" href="https://bsky.app/profile/{{ m.blueskyusername }}"><i class="fa-brands fa-bluesky"></i></a>
{%- endif %}
{% if m.mastodonusername %}
  - <a target="_blank" href="https://{{ m.mastodoninstance }}/@{{ m.mastodonusername }}"><i class="fa-brands fa-mastodon"></i></a>
{%- endif %}
{% if m.twitterusername %}
  - <a target="_blank" href="https://twitter.com/{{ m.twitterusername }}"><i class="fa-brands fa-twitter"></i></a>
{%- endif %}
{% if m.instagramusername %}
  - <a target="_blank" href="https://www.instagram.com/{{ m.instagramusername }}"><i class="fa-brands fa-instagram"></i></a>
{%- endif %}
{% if m.youtubeusername %}
  - <a target="_blank" href="https://www.youtube.com/{{ m.youtubeusername }}"><i class="fa-brands fa-youtube"></i></a>
{%- endif %}
{% if m.tiktokusername %}
  - <a target="_blank" href="https://www.tiktok.com/@{{ m.tiktokusername }}"><i class="fa-brands fa-tiktok"></i></a>
{%- endif %}
{% if m.stravausername %}
  - <a target="_blank" href="https://www.strava.com/athletes/{{ m.stravausername }}"><i class="fa-brands fa-strava"></i></a>
{%- endif %}
