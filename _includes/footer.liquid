{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      <div class="row align-items-center">
        <!-- Left side: Copyright and info -->
        <div class="col-md-8 text-md-start text-left">
          <strong>
            &copy; {{ site.publication_year }}
            {{ site.title -}}
          </strong>
          @ {{ site.affiliation_short }}
          <span class="fi fi-{{ site.country }}"></span>.
          {% assign site_info_page = site.pages | where: 'permalink', '/site_info/' | first %}
          <a href="{{ site.url }}{{ site.baseurl }}/site_info/"> {{ site_info_page.title }}. </a>
          {% if site.impressum_path %}
            <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
          {% endif %}
          {% if site.last_updated %}
            {{ site.data[site.active_lang].strings.footer.last_updated }}: {{ 'now' | date: '%B %d, %Y' }}.
          {% endif %}
        </div>

        <!-- Right side: Footer navigation (with toggle) -->
        <div class="col-md-4 text-md-end text-right footer-nav">
          <nav class="navbar navbar-light navbar-expand-sm justify-content-end" role="navigation">
            <!-- Footer Toggle Button (hamburger) -->
            <button
              class="navbar-toggler collapsed ml-auto"
              type="button"
              data-toggle="collapse"
              data-target="#footerNav"
              aria-controls="footerNav"
              aria-expanded="false"
              aria-label="Toggle footer navigation"
            >
              <span class="sr-only">Toggle footer navigation</span>
              <span class="icon-bar top-bar"></span>
              <span class="icon-bar middle-bar"></span>
              <span class="icon-bar bottom-bar"></span>
            </button>

            <!-- Collapsible Footer Menu -->
            <div class="collapse navbar-collapse text-right" id="footerNav">
              <ul class="navbar-nav ml-auto flex-nowrap">
                {% assign footer_pages = site.pages | where: 'nav_footer', true | sort: 'nav_order' %}
                {% for p in footer_pages %}
                  <li class="nav-item {% if page.url == p.url %}active{% endif %}">
                    <a class="nav-link" href="{{ p.url | relative_url }}">
                      {{- p.title -}}
                      {% if page.url == p.url %}
                        <span class="sr-only">(current)</span>
                      {% endif %}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          </nav>
        </div>
      </div>
    </div>
  </footer>

{% else %}
  <footer class="sticky-bottom mt-3" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include scripts/newsletter.liquid %}
    {% endif %}

    <div class="container">
      <div class="row align-items-center">
        <!-- Left side -->
        <div class="col-md-8 text-md-start text-left">
          <strong>
            &copy; {{ site.publication_year }}
            {{ site.title }}
          </strong>
          @ {{ site.affiliation_short }}
          <span class="fi fi-{{ site.country }}"></span>.
          {% assign site_info_page = site.pages | where: 'permalink', '/site_info/' | first %}
          <a href="{{ site.url }}{{ site.baseurl }}/site_info/"> {{ site_info_page.title }}. </a>
          {% if site.impressum_path %}
            <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
          {% endif %}
          {% if site.last_updated %}
            {% assign month_key = 'now' | date: '%B' | downcase %}
            {{ site.data[site.active_lang].strings.footer.last_updated }}:
            {{ site.data[site.active_lang].strings.months.long[month_key] }}
            {{ 'now' | date: '%d, %Y' }}.
          {% endif %}
        </div>

        <!-- Right side: Footer navigation -->
        <div class="col-md-4 text-md-end text-right footer-nav">
          <nav class="navbar navbar-light navbar-expand-sm justify-content-end" role="navigation">
            <button
              class="navbar-toggler collapsed ml-auto"
              type="button"
              data-toggle="collapse"
              data-target="#footerNav"
              aria-controls="footerNav"
              aria-expanded="false"
              aria-label="Toggle footer navigation"
            >
              <span class="sr-only">Toggle footer navigation</span>
              <span class="icon-bar top-bar"></span>
              <span class="icon-bar middle-bar"></span>
              <span class="icon-bar bottom-bar"></span>
            </button>

            <div class="collapse navbar-collapse text-right" id="footerNav">
              <ul class="navbar-nav ml-auto flex-nowrap">
                {% assign footer_pages = site.pages | where: 'nav_footer', true | sort: 'nav_order' %}
                {% for p in footer_pages %}
                  <li class="nav-item {% if page.url == p.url %}active{% endif %}">
                    <a class="nav-link" href="{{ p.url | relative_url }}">
                      {{- p.title -}}
                      {% if page.url == p.url %}
                        <span class="sr-only">(current)</span>
                      {% endif %}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          </nav>
        </div>
      </div>
    </div>
  </footer>
{% endif %}
