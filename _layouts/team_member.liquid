---
layout: default
---

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="team-member-page">
  <div class="row">
    <!-- Left side: Image and contact info (1/3) -->
    <div class="col-md-4">
      <div style="text-align: center;">
        {% assign photo = page.photo | default: "bio_photo.jpg" %}
        <img 
          src="{{ site.url }}{{ site.baseurl }}/assets/img/teampic/{{ photo }}" 
          class="img-rounded img-shadow" 
          style="width:100%; max-width:300px; border-radius:50%; margin-bottom:20px;" 
          alt="{{ page.name }}"
        />
        
        <!-- Contact and social links -->
        <p style="margin-bottom:15px; font-size:120%;">
          {% if page.email %}
            <i class="fas fa-envelope"></i> <a target="_blank" href="mailto:{{ page.email }}" title="Email">
              {{ page.email | replace: "@", "[at]" }}
            </a>
          {% endif %}
          {% if page.cv %}
            <br>
            <a target="_blank" href="{{ site.url }}{{ site.baseurl }}/assets/img/teamcv/{{ page.cv }}" title="CV">
              <i class="ai ai-cv"></i>
            </a>
          {% endif %}
        <!-- Social media links -->
        {% include social_page.liquid member=page %}
        </p>
      </div>
    </div>

    <!-- Right side: Country,Name, position, and content (2/3) -->
    <div class="col-md-8">
      <h1 style="margin-top:0; margin-bottom:5px;"> <span class="fi fi-{{ page.country }}"></span> {{ page.name }}</h1>
      
      <!-- Position and affiliation -->
      <p style="margin-bottom:10px; margin-top:10px;">
        <strong>{{ page.position }}{% if page.affiliation %}, {{ page.affiliation }}{% endif %}</strong><br>
        <em>Since {{ page.started }}</em>
      </p>

      <!-- Education section -->
      {% if page.education %}
        <hr style="margin:10px 0;">
        <h4>Education</h4>
        <ul style="margin-bottom:20px;">
        {% for ed in page.education %}
          <li>
            <strong>{{ ed.program }}</strong><br>
            {{ ed.institution }} 
            <span class="fi fi-{{ ed.country }}"></span>
          </li>
        {% endfor %}
        </ul>
      {% endif %}

      <!-- Main content from markdown body -->
      <hr style="margin:10px 0;">
      <div style="margin-bottom:10px;">
        {{ content }}
      </div>
    </div>
  </div>
</div>