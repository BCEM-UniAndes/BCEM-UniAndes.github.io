---
layout: default
---
<div class="post">
  <!-- Banner or Title -->
  <header class="post-header-about">
    {% if page.banner %}
      <div class="profile-image">
        {% assign profile_image_path = site.url | append: site.baseurl | append: '/assets/img/logopic/' | append: page.banner %}
        {% assign profile_image_class = 'img-fluid w-100' %}
        {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class alt=page.banner cache_bust=true %}
      </div>
    {% else %}
      <h1 class="post-title"></h1>
      <span class="font-weight-bold" style="font-size: 4em;">{{ site.title_long }}</span>
    {% endif %}
    {% if page.affiliation_logo %}
      <img src="{{ site.url }}{{ site.baseurl }}/assets/img/logopic/{{ page.affiliation_logo }}" style="height:64px;">
    {% elsif page.subtitle %}
      <p class="desc">{{ page.subtitle }}</p>
    {% endif %}
    <!-- Other language Message & Link -->
    {% if page.other_lang.include %}
      <p class="desc">
        - {{ page.other_lang.message }}
        <a href="{{ site.url }}{{ site.baseurl }}{{ page.other_lang.url }}">{{ page.other_lang.name }}</a> -
      </p>
    {% endif %}
  </header>

  <!-- Main Content -->
  <article>
    <div class="clearfix" style="text-align: justify">{{ content }}</div>

    <!-- Recruiting Callout -->
    {% if page.recruitment_callout %}
      <div class="callout">
        <p class="mb-2" style="font-size: 1.05rem;">
          <strong>{{ site.data[site.active_lang].strings.callout_opening }}</strong>
        </p>
        <ul class="list-unstyled mb-0">
          {% for opportunity in page.recruitment_callout %}
            <li class="mb-1">
              •
              <a href="{{ site.url }}{{ site.baseurl }}/{{ opportunity.announcement_page }}" class="fw-bold">
                {{ opportunity.position_available }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    <!-- Image carousel -->
    {% if page.homeslides != null %}
      {% include carousel.liquid slides=page.homeslides %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>
        <div class="contact-note" style="font-size: 1.17em;">
          {{ site.data[site.active_lang].strings.contact_note }}
        </div>
      </div>
    {% endif %}

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">{{ site.data[site.active_lang].strings.news }}</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">{{ site.data[site.active_lang].strings.selected_publications }}</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Affiliations & Sponsors -->
    {% if site.data.affiliations_and_sponsors %}
      <h2>{{ site.data[site.active_lang].strings.about.affiliations }} & {{ site.data[site.active_lang].strings.about.sponsors }}</h2>
      <figure class="fourth" style="text-align: center; margin-top: 20px; margin-bottom: 20px;">
        {% for affiliation in site.data.affiliations_and_sponsors %}
          <a href="{{ affiliation.url }}" target="_blank" rel="noopener">
            <img
              src="{{ site.url }}{{ site.baseurl }}/assets/img/affilpic/{{ affiliation.logo }}"
              style="height: 85px; margin-right: 10px; margin-bottom: 10px"
              alt="{{ affiliation.name }}"
            >
          </a>
        {% endfor %}
      </figure>
    {% endif %}

    <!-- Collaborators -->
    {% if site.data.collaborators %}
      <h2>
        {{ site.data[site.active_lang].strings.about.collaborators }}
      </h2>
      <figure class="fourth" style="text-align: center; margin-top: 20px; margin-bottom: 20px;">
        {% for collaborator in site.data.collaborators %}
          <a href="{{ collaborator.url }}" target="_blank" rel="noopener">
            <img
              src="{{ site.url }}{{ site.baseurl }}/assets/img/collabpic/{{ collaborator.logo }}"
              style="height: 95px; margin-right: 10px; margin-bottom: 10px"
              alt="{{ collaborator.name }}"
            >
          </a>
        {% endfor %}
      </figure>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
